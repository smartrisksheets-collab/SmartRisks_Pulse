-.pl-avatar { width: 34px; height: 34px; border-radius: var(--pl-r-pill); background: var(--pl-teal); color: #06231b; display: inline-grid; place-items: center; font-weight: 800; font-size: 12.5px; flex: none; object-fit: cover; }
+.pl-avatar { width: 34px; height: 34px; border-radius: var(--pl-r-pill); background: var(--pl-teal); color: var(--pl-on-teal); display: inline-grid; place-items: center; font-weight: 800; font-size: 12.5px; flex: none; object-fit: cover; }
 .pl-avatar.pl-lg { width: 56px; height: 56px; font-size: 19px; }
 
